# Backend Environment Variables
# Copy this file to .env.local and fill in your actual local values.
# Do not create backend/.env for this Firebase Functions project; Firebase deploys
# values from .env as production environment variables.

# Firebase Admin SDK
# Download your service account key from Firebase Console:
# Project Settings > Service Accounts > Generate New Private Key
# Place the downloaded JSON file in this directory and update the path below
LXROSE_ADMIN_SDK_PATH=./your-firebase-adminsdk.json

# JWT Secret
# Generate a strong random secret: openssl rand -base64 32
# IMPORTANT: Change this to a secure random string!
JWT_SECRET=your_secure_jwt_secret_here_change_this_to_something_random

# Server Configuration
LXROSE_PORT=5001

# Firebase Database URL
# Use an app-specific env name for Functions; FIREBASE_* names are reserved by Firebase.
LXROSE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Admin API Key
ADMIN_API_KEY=replace_with_a_strong_random_admin_api_key

# Comma-separated browser origins that can call the backend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,https://lxroseinc.com,https://www.lxroseinc.com,https://lxrose.org,https://www.lxrose.org

# Firebase Functions deployment notes:
# - Do not deploy LXROSE_ADMIN_SDK_PATH or the service account JSON.
#   Deployed Functions use the Firebase/Google runtime service account automatically.
# - Set production secrets before deploying:
#   firebase functions:secrets:set JWT_SECRET --project lxroseinc
#   firebase functions:secrets:set ADMIN_API_KEY --project lxroseinc
