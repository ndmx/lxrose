rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function publicSubmissionFields() {
      return request.resource.data.keys().hasOnly([
        'name',
        'email',
        'phone',
        'subject',
        'message',
        'timestamp',
        'status',
        'serviceCategory',
        'additionalInfo',
        'service',
        'selectedService',
        'serviceId',
        'serviceTitle',
        'serviceType',
        'notes',
        'patientAge',
        'careDuration',
        'startDate',
        'contactInfo',
        'additionalNotes',
        'qualifications',
        'yearsOfExperience',
        'availability',
        'info'
      ]);
    }

    function hasTimestamp() {
      return request.resource.data.timestamp is timestamp;
    }

    match /contactForms/{documentId} {
      allow create: if publicSubmissionFields() && hasTimestamp();
      allow read, update, delete: if false;
    }

    match /joinForms/{documentId} {
      allow create: if publicSubmissionFields() && hasTimestamp();
      allow read, update, delete: if false;
    }

    match /mentalServicesBookings/{documentId} {
      allow create: if publicSubmissionFields() && hasTimestamp();
      allow read, update, delete: if false;
    }

    match /nursingServiceBookings/{documentId} {
      allow create: if publicSubmissionFields() && hasTimestamp();
      allow read, update, delete: if false;
    }

    match /nurseRegistrations/{documentId} {
      allow create: if publicSubmissionFields() && hasTimestamp();
      allow read, update, delete: if false;
    }

    match /nutritionServiceBookings/{documentId} {
      allow create: if publicSubmissionFields() && hasTimestamp();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
