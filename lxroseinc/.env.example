# Frontend Environment Variables
# Copy this file to .env for local overrides.

# Backend API URL used by the admin dashboard.
# Local dev can use the standalone backend.
# Production defaults to same-origin Firebase Hosting rewrites when this is unset.
VITE_API_BASE_URL=http://localhost:5001

# Optional local override. Uncomment to force admin mode on localhost.
# VITE_SITE_MODE=admin
